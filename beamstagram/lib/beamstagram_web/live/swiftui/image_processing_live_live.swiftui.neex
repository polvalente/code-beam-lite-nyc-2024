
<LiveForm
  id="filter-form"
  phx-change="update_filter"
>
  <VStack style="padding(100)">
  <NxCameraFunction
    bytecode={if(@bytecode && @bytecode.ok? && @bytecode.result, do: Base.encode64(@bytecode.result))}
    device={"local-sync://"}
    height={480}
    width={640}
  />
  <.input
      style="pickerStyle(.segmented)"
      type="Picker"
      name="filter"
      value={@filter_params.filter}
      options={Enum.reject(@filter_options, fn {k, _} -> k == :None or k == :Tint end)} />
    <Divider />
    <HStack>
      <Text>Kernel Size</Text>
      <.input type="Stepper" name="kernel_size" value={@filter_params.kernel_size || 1} lowerBound={1} upperBound={21} step={2} />
      <Text><%= @filter_params.kernel_size %></Text>
      <Spacer />
    </HStack>
    <HStack :if={@filter_params.filter in [:gaussian_blur, :sharpen]}>
      <Text>Sigma</Text>
      <.input type="Slider" name="sigma" value={@filter_params.sigma || 0.1} step={0.5} lowerBound={0.1} upperBound={50} />
      <Text><%= @filter_params.sigma %></Text>
      <Spacer />
    </HStack>
    <HStack :if={@filter_params.filter == :sharpen}>
      <Text>Blur Kernel</Text>
      <.input type="Picker" style="pickerStyle(.segmented)" name="blur_kernel" value={@filter_params.blur_kernel || :gaussian_blur} options={@blur_kernel_options} />
    </HStack>
  </VStack>
</LiveForm>
